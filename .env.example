# Copy this file to .env.local and adjust the values.

# Password for the /admin content editor. CHANGE THIS before deploying.
ADMIN_PASSWORD=changeme

# Public site URL, used for canonical links and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site name used in metadata and JSON-LD organization schema.
NEXT_PUBLIC_SITE_NAME=Site Name

# Optional Open Graph image path under /public (e.g. /og.jpg).
# NEXT_PUBLIC_OG_IMAGE=/og.jpg
